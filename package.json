{
  "name": "powerpay-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "PowerPay mobile-first payments platform for Solana, Sui, USDC, EURC and PWRC.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @powerpay/mobile start",
    "mobile": "pnpm --filter @powerpay/mobile start",
    "api": "pnpm --filter @powerpay/api dev",
    "typecheck": "pnpm -r typecheck",
    "check": "node scripts/check-structure.mjs && node scripts/check-root-docs.mjs && node scripts/check-assets.mjs && node scripts/check-program-registry.mjs && node scripts/check-actions-manifest.mjs && node scripts/check-payment-invariants.mjs && node scripts/check-pnpm-build-policy.mjs && node scripts/check-expo-config.mjs && node scripts/check-web-experience.mjs && node scripts/check-env-layout.mjs && node scripts/check-solana-api.mjs && node scripts/check-sui-api.mjs && node scripts/check-public-env-secrets.mjs && node scripts/check-full-stack.mjs && pnpm -r typecheck",
    "programs:check": "node scripts/check-program-registry.mjs",
    "backend": "pnpm --filter @powerpay/backend typecheck",
    "services": "pnpm --filter @powerpay/services typecheck",
    "check:structure": "node scripts/check-structure.mjs",
    "check:programs": "node scripts/check-program-registry.mjs",
    "check:actions": "node scripts/check-actions-manifest.mjs",
    "check:payments": "node scripts/check-payment-invariants.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:import-user": "node scripts/import-user-brand-assets.mjs",
    "assets:sync-web3icons": "node scripts/sync-web3icons.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "deps:approve-builds": "pnpm approve-builds",
    "check:build-policy": "node scripts/check-pnpm-build-policy.mjs",
    "web": "pnpm --filter @powerpay/web dev",
    "web:clear": "node scripts/clean.mjs cache",
    "ios": "pnpm --filter @powerpay/mobile ios",
    "ios:native": "pnpm --filter @powerpay/mobile ios:native",
    "ios:doctor": "node scripts/check-ios-toolchain.mjs",
    "expo:doctor": "pnpm --filter @powerpay/mobile doctor",
    "check:expo": "node scripts/check-expo-config.mjs",
    "website": "pnpm --filter @powerpay/web dev",
    "website:build": "pnpm --filter @powerpay/web build",
    "website:typecheck": "pnpm --filter @powerpay/web typecheck",
    "mobile:web": "pnpm --filter @powerpay/mobile web",
    "mobile:web:clear": "pnpm --filter @powerpay/mobile web:clear",
    "web:build": "pnpm --filter @powerpay/web build",
    "check:web": "node scripts/check-web-experience.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "doctor:local": "bash scripts/doctor-local.sh",
    "repair:macos": "bash scripts/repair-macos-runtime.sh",
    "clean": "node scripts/clean.mjs cache",
    "clean:all": "node scripts/clean.mjs all",
    "env:sync": "node scripts/sync-env.mjs",
    "env:check": "node scripts/check-env-layout.mjs",
    "setup:local": "pnpm env:sync && pnpm doctor:local",
    "check:env": "node scripts/check-env-layout.mjs",
    "deps:trace-deprecated": "bash scripts/trace-deprecated-deps.sh",
    "deps:deprecated": "bash scripts/trace-deprecated-deps.sh",
    "ios:simulator:restart": "bash scripts/restart-ios-simulator.sh",
    "check:solana-api": "node scripts/check-solana-api.mjs",
    "check:sui-api": "node scripts/check-sui-api.mjs",
    "check:chain-read": "node scripts/check-solana-api.mjs && node scripts/check-sui-api.mjs",
    "check:public-env": "node scripts/check-public-env-secrets.mjs",
    "check:full-stack": "node scripts/check-full-stack.mjs",
    "check:root-docs": "node scripts/check-root-docs.mjs"
  },
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "devDependencies": {
    "@web3icons/core": "4.0.55",
    "sharp": "0.35.4"
  }
}
