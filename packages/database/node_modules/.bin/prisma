else
  export NODE_PATH="/Users/miko/github/powerchain/powerpay/node_modules/.pnpm/prisma@8.0.0-rc.12_@types+node@26.4.0_@types+react@19.2.18_@vercel+nft@1.11.0_supports-_69abd4fa0485e2ed466099c9ffdcfcf6/node_modules/prisma/node_modules:/Users/miko/github/powerchain/powerpay/node_modules/.pnpm/prisma@8.0.0-rc.12_@types+node@26.4.0_@types+react@19.2.18_@vercel+nft@1.11.0_supports-_69abd4fa0485e2ed466099c9ffdcfcf6/node_modules:/Users/miko/github/powerchain/powerpay/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../prisma/dist/prisma.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../prisma/dist/prisma.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../prisma/dist/prisma.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../prisma/dist/prisma.js" "$@"
else
  exec node  "$basedir/../prisma/dist/prisma.js" "$@"
fi
