generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Chain {
  SOLANA
  SUI
}

enum PaymentStatus {
  CREATED
  LOCKED
  SIGNING
  SIGNED
  SUBMITTED
  CONFIRMING
  CONFIRMED
  SETTLING
  SETTLED
  RECOVERY_REQUIRED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATED
  SIGNING
  SIGNED
  SUBMITTING
  SUBMITTED
  CONFIRMING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum MerchantTrustStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  RESTRICTED
  SUSPENDED
}

enum WalletConnectionStatus {
  CONNECTED
  DISCONNECTED
  REVOKED
  UNSUPPORTED
}

enum WalletPermission {
  READ_ADDRESS
  READ_BALANCES
  REQUEST_SIGNATURE
  REQUEST_TRANSACTION
}

model User {
  id          String         @id @default(cuid())
  externalId  String         @unique
  email       String?
  displayName String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  profile     Profile?
  wallets     Wallet[]
  payments    PaymentIntent[]
  devices     Device[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  defaultAsset    String   @default("USDC")
  secondaryAsset  String   @default("EURC")
  displayCurrency String   @default("EUR")
  locale          String   @default("en-FI")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String   @unique
  platform    String
  trusted     Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id          String                 @id @default(cuid())
  userId      String
  chain       Chain
  address     String
  label       String?
  walletType  String?
  status      WalletConnectionStatus @default(CONNECTED)
  primary     Boolean                @default(false)
  connectedAt DateTime               @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consents    WalletConsent[]
  @@unique([chain, address])
  @@index([userId, chain, status])
}

model WalletConsent {
  id          String             @id @default(cuid())
  walletId    String
  permissions WalletPermission[]
  acceptedAt  DateTime           @default(now())
  revokedAt   DateTime?
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, revokedAt])
}

model Merchant {
  id               String              @id @default(cuid())
  name             String
  trustStatus      MerchantTrustStatus @default(UNVERIFIED)
  settlementWallet String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  locations        MerchantLocation[]
  checkouts        Checkout[]
  payments         PaymentIntent[]
}

model MerchantLocation {
  id         String   @id @default(cuid())
  merchantId String
  name       String
  city       String?
  country    String?
  terminalId String?
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@index([merchantId])
}

model Checkout {
  id         String   @id @default(cuid())
  merchantId String
  network    Chain    @default(SOLANA)
  asset      String   @default("USDC")
  amount     Decimal  @db.Decimal(40, 18)
  recipient  String
  reference  String   @unique
  nonce      String   @unique
  expiresAt  DateTime
  multiUse   Boolean  @default(false)
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@index([merchantId, expiresAt])
}

model QrNonce {
  nonce      String   @id
  expiresAt  DateTime
  consumedAt      DateTime?
  paymentIntentId String?
  createdAt       DateTime @default(now())
  @@index([expiresAt, consumedAt])
}

model PaymentIntent {
  id             String        @id
  idempotencyKey String        @unique
  userId         String?
  merchantId     String?
  source         String
  network        String
  asset          String
  amount         Decimal       @db.Decimal(40, 18)
  fiatCurrency   String
  recipient      String
  reference      String?
  checkoutId     String?
  nonce          String?
  expiresAt      DateTime?
  status         PaymentStatus @default(CREATED)
  lockedAt       DateTime?
  lockHash       String?
  createdAt      DateTime
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  merchant       Merchant?     @relation(fields: [merchantId], references: [id])
  quotes         PaymentQuote[]
  attempts       PaymentAttempt[]
  receipt        PaymentReceipt?
  ledgerEntries  LedgerEntry[]
  @@index([userId, createdAt])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
  @@index([checkoutId])
}

model PaymentQuote {
  id              String        @id
  paymentIntentId String
  asset           String
  network         String
  subtotal        Decimal       @db.Decimal(40, 18)
  serviceFee      Decimal       @db.Decimal(40, 18)
  protocolFee     Decimal       @db.Decimal(40, 18)
  networkFee      Decimal       @db.Decimal(40, 18)
  total           Decimal       @db.Decimal(40, 18)
  quoteHash       String?       @unique
  signature       String?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  @@index([paymentIntentId, expiresAt])
}

model PaymentAttempt {
  id              String               @id
  idempotencyKey  String               @unique
  paymentIntentId String
  sequence        Int
  network         String
  walletAddress   String?
  feeQuoteId      String?
  status          PaymentAttemptStatus @default(CREATED)
  transactionId   String?
  signedTransactionHash String?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime
  updatedAt       DateTime
  paymentIntent   PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  ledgerEntries   LedgerEntry[]
  @@unique([paymentIntentId, sequence])
  @@index([transactionId])
  @@index([status, updatedAt])
}

model LedgerEntry {
  id              String          @id
  paymentIntentId String
  attemptId       String?
  type            String
  status          PaymentStatus
  transactionId   String?
  metadata        Json?
  createdAt       DateTime
  paymentIntent   PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  attempt         PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@index([paymentIntentId, createdAt])
  @@index([transactionId])
}

model PaymentReceipt {
  receiptId        String        @id
  paymentIntentId  String        @unique
  attemptId        String
  network          String
  transactionId    String
  merchantId       String?
  merchantName     String?
  payer            String?
  asset            String
  amount           Decimal       @db.Decimal(40, 18)
  fees             Json
  timestamp        DateTime
  settlementStatus String
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  @@index([transactionId])
  @@index([timestamp])
}

model Refund {
  id              String   @id @default(cuid())
  paymentIntentId String
  amount          Decimal  @db.Decimal(40, 18)
  asset           String
  reason          String?
  transactionId   String?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([paymentIntentId, createdAt])
}

model Settlement {
  id              String   @id @default(cuid())
  paymentIntentId String   @unique
  attemptId       String
  transactionId   String
  status          String
  settledAt       DateTime
  createdAt       DateTime @default(now())
}

model Token {
  id                 String   @id @default(cuid())
  chain              Chain
  network            String
  mint               String
  symbol             String
  name               String
  decimals           Int
  tokenProgram       String?
  metadataUri        String?
  imageUrl           String?
  verified           Boolean  @default(false)
  enabledForPayments Boolean  @default(false)
  enabledForSwap     Boolean  @default(false)
  enabledForBridge   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([chain, network, mint])
  @@index([symbol, enabledForPayments])
}

model RpcProvider {
  id                    String   @id @default(cuid())
  chain                 Chain
  network               String
  name                  String
  type                  String
  rpcUrlEncrypted       String
  websocketUrlEncrypted String?
  enabled               Boolean  @default(true)
  priority              Int      @default(100)
  latencyMs             Int?
  status                String   @default("UNKNOWN")
  lastHealthCheck       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([chain, network, enabled, priority])
}

model ProgramDeployment {
  id             String   @id @default(cuid())
  chain          Chain
  network        String
  name           String
  programId      String
  version        String
  idlHash        String?
  deploymentHash String?
  deploymentSlot BigInt?
  authority      String?
  verified       Boolean  @default(false)
  status         String   @default("PENDING")
  activeFrom     DateTime @default(now())
  retiredAt      DateTime?
  @@unique([chain, network, name, version])
  @@index([chain, network, name, retiredAt])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  metadata  Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SwapQuote {
  id                     String   @id @default(cuid())
  provider               String
  chain                  Chain
  inputAsset             String
  outputAsset            String
  inputAmountAtomic      Decimal  @db.Decimal(40, 0)
  expectedOutputAtomic   Decimal  @db.Decimal(40, 0)
  minimumOutputAtomic    Decimal  @db.Decimal(40, 0)
  priceImpactBps         Int
  estimatedNetworkFeeUsd Decimal? @db.Decimal(24, 8)
  routeJson              Json
  expiresAt              DateTime
  createdAt              DateTime @default(now())
}

model CrossChainTransfer {
  id                     String   @id @default(cuid())
  provider               String
  sourceChain            Chain
  destinationChain       Chain
  asset                  String
  amountAtomic           Decimal  @db.Decimal(40, 0)
  recipient              String
  status                 String
  sourceTransaction      String?
  attestationId          String?
  destinationTransaction String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@index([status, updatedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String
  severity  String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model IdempotencyRecord {
  key          String   @id
  scope        String
  resourceType String
  resourceId   String
  responseHash String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  @@index([resourceType, resourceId])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  deviceId    String?
  severity    String
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  objectType String
  objectId   String
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([objectType, objectId, createdAt])
}
