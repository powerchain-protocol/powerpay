EXPO_PUBLIC_SUI_NETWORK=devnet
EXPO_PUBLIC_DEFAULT_ASSET=USDC
EXPO_PUBLIC_DEFAULT_FIAT=EUR
# Optional. WalletConnect/Reown remains disabled until its connector adapter is deployed.
EXPO_PUBLIC_REOWN_PROJECT_ID=
# Development only; ignored by production API deployments
EXPO_PUBLIC_POWERPAY_DEVELOPMENT_USER=development-user

# Solana / Helius - server only unless explicitly prefixed EXPO_PUBLIC_
