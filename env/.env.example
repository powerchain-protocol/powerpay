# Canonical inventory is also mirrored at env/.env.example.
# Runtime
POWERPAY_ENV=development
POWERPAY_PUBLIC_BASE_URL=http://localhost:8787
POWERPAY_ALLOWED_ORIGINS=http://localhost:3000
POWERPAY_RELEASE=1.0.0
POWERPAY_COMMIT_SHA=
EXPO_PUBLIC_POWERPAY_API_URL=http://localhost:8787
