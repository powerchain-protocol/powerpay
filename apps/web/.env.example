# Server-side PowerPay API origin used by the same-origin /api/powerpay proxy.
# Example local Worker: http://127.0.0.1:8787
POWERPAY_API_URL=http://127.0.0.1:8787

# Optional: bypass the same-origin proxy from the browser. Leave unset unless the
# external API explicitly permits your web origin through CORS.
NEXT_PUBLIC_POWERPAY_API_URL=

# Demo checkout merchant configuration. Execution stays fail-closed if recipient is blank.
NEXT_PUBLIC_POWERPAY_DEMO_MERCHANT_ID=powerpay-web-demo
NEXT_PUBLIC_POWERPAY_DEMO_MERCHANT_NAME=PowerPay Demo Store
NEXT_PUBLIC_POWERPAY_DEMO_RECIPIENT=
NEXT_PUBLIC_POWERPAY_DEMO_AMOUNT=125.00

# Multi-environment web routing. If omitted, POWERPAY_API_URL is used for both.
POWERPAY_API_URL_DEVNET=http://127.0.0.1:8787
POWERPAY_API_URL_MAINNET_BETA=
NEXT_PUBLIC_POWERPAY_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_POWERPAY_RPC_PROFILE=managed
NEXT_PUBLIC_ENABLE_MAINNET_BETA=false
# Safe capability boolean only; never expose the custom RPC URL to the browser.
NEXT_PUBLIC_HAS_CUSTOM_RPC=false

# Funding providers. Keep secrets server-only.
STRIPE_SECRET_KEY=
MOONPAY_ONRAMP_URL=
COINBASE_PAY_ONRAMP_URL=

# Public social destinations
NEXT_PUBLIC_POWERPAY_X_URL=https://x.com/powerchain_ai
NEXT_PUBLIC_POWERPAY_GITHUB_URL=https://github.com/powerchain-protocol
NEXT_PUBLIC_POWERPAY_TELEGRAM_URL=
NEXT_PUBLIC_POWERPAY_MEDIUM_URL=

# Sui read API selection
NEXT_PUBLIC_SUI_NETWORK=devnet
